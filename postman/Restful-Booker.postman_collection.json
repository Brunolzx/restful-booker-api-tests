{
  "info": {
    "name": "Restful-Booker \u2014 API Test Suite",
    "description": "End-to-end API test suite for the Restful-Booker API (https://restful-booker.herokuapp.com).\n\nCovers authentication, full CRUD, request chaining, schema and field validation, and negative testing. Documented API quirks live in docs/FINDINGS.md.\n\nAuthor: Bruno Moreira.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health Check",
      "item": [
        {
          "name": "GET /ping - API is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 (service is healthy)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "POST /auth - valid credentials returns token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response contains a non-empty token\", function () {",
                  "    pm.expect(body).to.have.property(\"token\");",
                  "    pm.expect(body.token).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "",
                  "// Chaining: store the token for protected requests (PUT/PATCH/DELETE)",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "POST /auth - invalid credentials are rejected (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: the API returns HTTP 200 even for bad credentials (documented quirk).",
                  "// See docs/FINDINGS.md - F-03.",
                  "pm.test(\"Status code is 200 (API quirk - see FINDINGS.md)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"No token is issued for bad credentials\", function () {",
                  "    pm.expect(body).to.not.have.property(\"token\");",
                  "    pm.expect(body).to.have.property(\"reason\", \"Bad credentials\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Create Booking",
      "item": [
        {
          "name": "POST /booking - create a booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response returns a numeric bookingid\", function () {",
                  "    pm.expect(body).to.have.property(\"bookingid\");",
                  "    pm.expect(body.bookingid).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Created booking echoes the request data\", function () {",
                  "    pm.expect(body.booking.firstname).to.eql(\"Bruno\");",
                  "    pm.expect(body.booking.lastname).to.eql(\"Moreira\");",
                  "    pm.expect(body.booking.totalprice).to.eql(150);",
                  "    pm.expect(body.booking.depositpaid).to.eql(true);",
                  "    pm.expect(body.booking.additionalneeds).to.eql(\"Breakfast\");",
                  "});",
                  "",
                  "pm.test(\"Booking object matches the expected schema\", function () {",
                  "    pm.expect(body.booking).to.have.all.keys(",
                  "        \"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"",
                  "    );",
                  "    pm.expect(body.booking.bookingdates).to.have.all.keys(\"checkin\", \"checkout\");",
                  "});",
                  "",
                  "// Chaining: store the id created so the next requests can use it",
                  "pm.collectionVariables.set(\"bookingid\", body.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Bruno\",\n  \"lastname\": \"Moreira\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-06-10\",\n    \"checkout\": \"2026-06-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Read Bookings",
      "item": [
        {
          "name": "GET /booking/:id - read the created booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is present\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Returned booking matches the data we created\", function () {",
                  "    pm.expect(body.firstname).to.eql(\"Bruno\");",
                  "    pm.expect(body.lastname).to.eql(\"Moreira\");",
                  "    pm.expect(body.totalprice).to.eql(150);",
                  "    pm.expect(body.bookingdates.checkin).to.eql(\"2026-06-10\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /booking - list all booking ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Response is a non-empty array of booking ids\", function () {",
                  "    pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(body[0]).to.have.property(\"bookingid\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /booking?firstname&lastname - filter by name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname=Bruno&lastname=Moreira",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "Bruno"
                },
                {
                  "key": "lastname",
                  "value": "Moreira"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Update Booking",
      "item": [
        {
          "name": "PUT /booking/:id - update without token (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Update without a token is forbidden (403)\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"NoAuth\",\n  \"totalprice\": 1,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-01-01\",\n    \"checkout\": \"2026-01-02\"\n  },\n  \"additionalneeds\": \"None\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "PUT /booking/:id - full update with token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"All fields were updated\", function () {",
                  "    pm.expect(body.firstname).to.eql(\"Bruno Filipe\");",
                  "    pm.expect(body.totalprice).to.eql(250);",
                  "    pm.expect(body.depositpaid).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Bruno Filipe\",\n  \"lastname\": \"Moreira\",\n  \"totalprice\": 250,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-06-10\",\n    \"checkout\": \"2026-06-20\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "PATCH /booking/:id - partial update with token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"Only the targeted field changed\", function () {",
                  "    pm.expect(body.additionalneeds).to.eql(\"Late checkout\");",
                  "});",
                  "",
                  "pm.test(\"Untouched fields kept their previous values\", function () {",
                  "    pm.expect(body.firstname).to.eql(\"Bruno Filipe\");",
                  "    pm.expect(body.totalprice).to.eql(250);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"additionalneeds\": \"Late checkout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Delete Booking",
      "item": [
        {
          "name": "DELETE /booking/:id - delete with token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: a successful DELETE returns 201 Created instead of 200/204.",
                  "// This is a documented quirk of the API - see docs/FINDINGS.md - F-01.",
                  "pm.test(\"Delete returns 201 (API quirk - see FINDINGS.md)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /booking/:id - deleted booking is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Reading a deleted booking returns 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Negative & Edge Cases",
      "item": [
        {
          "name": "GET /booking/:id - non-existent id returns 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Non-existent booking returns 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/9999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "9999999"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookingid",
